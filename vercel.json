{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/plataforma-academica/browser",
  "installCommand": "pnpm install",
  "rewrites": [
    {
      "source": "/api/usuarios/:path*",
      "destination": "https://lumina-usuarios.onrender.com/api/:path*"
    },
    {
      "source": "/api/estudiantes/:path*",
      "destination": "https://lumina-estudiantes.onrender.com/api/:path*"
    },
    {
      "source": "/api/cursos/:path*",
      "destination": "https://lumina-cursos.onrender.com/api/:path*"
    },
    {
      "source": "/api/evaluaciones/:path*",
      "destination": "https://lumina-evaluaciones.onrender.com/api/:path*"
    },
    {
      "source": "/api/noticias/:path*",
      "destination": "https://lumina-noticiaseventos.onrender.com/api/:path*"
    },
    {
      "source": "/api/docentes/:path*",
      "destination": "https://lumina-docentes.onrender.com/api/:path*"
    },
    {
      "source": "/api/carreras/:path*",
      "destination": "https://lumina-carreras.onrender.com/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET,POST,PUT,DELETE,PATCH,OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type,Authorization,X-Requested-With,Accept"
        }
      ]
    }
  ],
  "env": {
    "NG_BUILD_CONFIGURATION": "production"
  }
}
